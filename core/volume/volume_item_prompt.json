{
    "fields": {
        "id": {
            "prompt": "请输入卷id，如置空，则由代码自动生成形如\"volume:十六位哈希\"的id",
            "not_allow": [
                ""
            ]
        },
        "name": {
            "prompt": "请输入卷名称，如果置空，则会与id一致",
            "not_allow": [
                ""
            ]
        },
        "capacity": {
            "prompt": "请输入卷容量，可以为空，如果mountpoint不为空，则会自动计算卷容量",
            "not_allow": [
                ""
            ]
        },
        "used": {
            "prompt": "请输入已使用容量，可以为空，如果mountpoint不为空，则会自动计算卷容量",
            "not_allow": [
                ""
            ]
        },
        "add_time": {
            "prompt": "请输入该卷的建立时间，如果置空，会以当前时间初始化",
            "not_allow": [
                ""
            ]
        },
        "last_check": {
            "prompt": "请输入上次对改卷进行检查的时间，如果置空，会以当前时间初始化",
            "not_allow": [
                ""
            ]
        },
        "healthy": {
            "prompt": "请输入卷容量，可以为空",
            "not_allow": [
                ""
            ]
        },
        "info": {
            "prompt": "请输入其他附加信息，可以为空"
        },
        "kind": {
            "prompt": "请输入其他raid信息",
            "not_allow": [
                ""
            ],
            "allow": [
                "raid0",
                "raid1",
                "raid5",
                "raidz1",
                "raid6",
                "raid10",
                "single_disk",
                "sub_volume"
            ],
            "must_legal":true

        },
        "mount_point": {
            "prompt": "请输入卷挂载点，可以置空"
        },
        "storages":{
            "prompt":"请输入构成这个卷的信息",
            "must_legal":true
        }
    }
}